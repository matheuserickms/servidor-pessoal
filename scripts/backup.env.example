# =============================================================================
# Destino no servidor: /etc/backup.env   (root:root, chmod 600)
#
# Contém a chave que descriptografa TODOS os seus backups. Guarde a
# RESTIC_PASSWORD também num gerenciador de senhas fora do servidor: sem ela,
# o backup é um bloco de ruído irrecuperável.
# =============================================================================

# --- Cloudflare R2 (10 GB grátis, sem cobrança de egress) --------------------
# Crie o bucket e um API token com permissão de Object Read & Write.
# O <account-id> aparece na URL do painel da Cloudflare.
export RESTIC_REPOSITORY="s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>"
export AWS_ACCESS_KEY_ID="<access-key-id>"
export AWS_SECRET_ACCESS_KEY="<secret-access-key>"

# --- Alternativa: Backblaze B2 (10 GB grátis) -------------------------------
# export RESTIC_REPOSITORY="b2:<nome-do-bucket>:servidor"
# export B2_ACCOUNT_ID="<keyID>"
# export B2_ACCOUNT_KEY="<applicationKey>"

# --- Chave de criptografia ---------------------------------------------------
# Gere uma vez com:  openssl rand -base64 32
# Trocar depois de criado o repositório exige recriar tudo.
export RESTIC_PASSWORD=""

# --- Monitoramento do próprio backup ----------------------------------------
# URL de um monitor do tipo "Push" no Uptime Kuma. O backup.sh chama esta URL
# ao terminar com sucesso; se o backup parar, o Kuma para de receber e te avisa.
#
# Sem isto, um backup que morre em silêncio só é descoberto no dia em que você
# precisa restaurar. Deixe vazio apenas até o Uptime Kuma estar no ar.
export BACKUP_PING_URL=""
