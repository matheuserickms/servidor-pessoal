# =============================================================================
# Identificadores da tenancy OCI, usados por criar-instancia.sh.
# Copie para oci.env (que não vai para o git) e preencha.
#
# Descobrir os valores:
#   oci iam availability-domain list --compartment-id <tenancy>
#   oci network subnet list --compartment-id <tenancy> --vcn-id <vcn>
#   oci compute image list --compartment-id <tenancy> \
#       --operating-system "Canonical Ubuntu" --operating-system-version "24.04" \
#       --shape "VM.Standard.A1.Flex" --sort-by TIMECREATED
# =============================================================================

export OCI_COMPARTMENT_ID=""
export OCI_AVAILABILITY_DOMAIN=""
export OCI_SUBNET_ID=""
export OCI_IMAGE_ID=""
