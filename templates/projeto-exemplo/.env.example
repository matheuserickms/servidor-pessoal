# =============================================================================
# Destino: /opt/stacks/<projeto>/.env   (chmod 600)
# =============================================================================

NODE_ENV=production
PORT=3000

# O host é "postgres" (nome do container na rede "data"), não localhost.
# Usuário, senha e database são criados por scripts/novo-projeto.sh.
DATABASE_URL=postgres://PROJETO:SENHA_AQUI@postgres:5432/PROJETO

# Suas chaves de API, tokens de bot, etc.
# TELEGRAM_BOT_TOKEN=
